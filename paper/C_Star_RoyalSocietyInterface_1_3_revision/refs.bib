@article{Hamzi2021,
  author    = { Boumediene Hamzi and Houman Owhadi },
  title     = { Learning dynamical systems from data: A simple cross-validation perspective, part I: Parametric kernel flows },
  journal   = { Physica D: Nonlinear Phenomena },
  year      = 2021,
  pages     = { 132817 },
  month     = 7,
  volume    = 421,
  publisher = { North-Holland },
  doi       = { 10.1016/J.PHYSD.2020.132817 },
  issn      = { 0167-2789 },
  abstract  = { Regressing the vector field of a dynamical system from a finite number of observed states is a natural way to learn surrogate models for such systems. We present variants of cross-validation (Kernel Flows (Owhadi and Yoo, 2019) and its variants based on Maximum Mean Discrepancy and Lyapunov exponents) as simple approaches for learning the kernel used in these emulators. },
