@article{staver2011,
  author   = { A. Carla Staver and Sally Archibald and Simon A. Levin },
  title    = { The Global Extent and Determinants of Savanna and Forest as Alternative Biome States },
  journal  = { Science },
  year     = 2011,
  pages    = { 230--232 },
  volume   = 334,
  number   = 6053,
  doi      = { 10.1126/science.1210465 },
  url      = { https://www.science.org/doi/abs/10.1126/science.1210465 },
  eprint   = { https://www.science.org/doi/pdf/10.1126/science.1210465 },
  abstract = { Savanna and forest are alternative states governed by fire at intermediate rainfall levels. Theoretically, fire–tree cover feedbacks can maintain savanna and forest as alternative stable states. However, the global extent of fire-driven discontinuities in tree cover is unknown, especially accounting for seasonality and soils. We use tree cover, climate, fire, and soils data sets to show that tree cover is globally discontinuous. Climate influences tree cover globally but, at intermediate rainfall (1000 to 2500 millimeters) with mild seasonality (less than 7 months), tree cover is bimodal, and only fire differentiates between savanna and forest. These may be alternative states over large areas, including parts of Amazonia and the Congo. Changes in biome distributions, whether at the cost of savanna (due to fragmentation) or forest (due to climate), will be neither smooth nor easily reversible. }
