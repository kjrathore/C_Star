@article{Yema2016,
  author   = { Lilen Yema and Elena Litchman and Paula De Tezanos Pinto },
  title    = { The role of heterocytes in the physiology and ecology of bloom-forming harmful cyanobacteria },
  journal  = { Harmful Algae },
  year     = 2016,
  pages    = { 131--138 },
  volume   = 60,
