\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Identification of the unobserved parameter $c_t$ from one of the random experiments. The actual parameter values (black) are compared with estimates from two methods: DE-Gaussian process (purple), and UDE-NN (green) and algebraically calculated harvest rate (dotted gray).}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:c_hat}{{4}{8}{Identification of the unobserved parameter $c_t$ from one of the random experiments. The actual parameter values (black) are compared with estimates from two methods: DE-Gaussian process (purple), and UDE-NN (green) and algebraically calculated harvest rate (dotted gray)}{figure.4}{}}
