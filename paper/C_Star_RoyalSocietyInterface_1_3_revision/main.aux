\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Classification-based predictions for the unobserved parameter $\hat  {c_t}$, identifying the current categorical regime of the system (I, II, III) based on the predicted values. Boxplot shows F-score performance ranges (the higher, the better) in different regimes. Box color indicates methods, Algebric in yellow, DE-Gaussian process (GP) in purple, and our method, UDE-NN in green.}}{10}{figure.6}\protected@file@percent }
\newlabel{fig:fscore}{{6}{10}{Classification-based predictions for the unobserved parameter $\hat {c_t}$, identifying the current categorical regime of the system (I, II, III) based on the predicted values. Boxplot shows F-score performance ranges (the higher, the better) in different regimes. Box color indicates methods, Algebric in yellow, DE-Gaussian process (GP) in purple, and our method, UDE-NN in green}{figure.6}{}}
\newlabel{fig:fscore@cref}{{[figure][6][]6}{[1][8][]10}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Comparative forecast performance using the root mean square error (RMSE) metric across different regimes and forecast horizons. Blue, yellow, olive and purple boxes represent ARIMA, RandomWalk, LSTM, and DE-Gaussian process methods, respectively, and green boxes correspond to the UDE-NN method. Grouped boxplots of the performance metric after training on 70 data points (Regime I), 220 data points (Regime II), and 300 data points (Regime III).}}{10}{figure.7}\protected@file@percent }
\newlabel{fig:rmse_forecasts_box}{{7}{10}{Comparative forecast performance using the root mean square error (RMSE) metric across different regimes and forecast horizons. Blue, yellow, olive and purple boxes represent ARIMA, RandomWalk, LSTM, and DE-Gaussian process methods, respectively, and green boxes correspond to the UDE-NN method. Grouped boxplots of the performance metric after training on 70 data points (Regime I), 220 data points (Regime II), and 300 data points (Regime III)}{figure.7}{}}
